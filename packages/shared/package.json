{
  "name": "@qayd/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-free shared TypeScript utilities and constants (API base URL, locales, KWD currency formatting).",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@qayd/config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
