APP_NAME=QAYD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qayd
DB_USERNAME=qayd
# Owner password. PLACEHOLDER — set this to your local Postgres password. It must match the
# `POSTGRES_PASSWORD` the Postgres container was created with (compose default: CHANGE_ME).
DB_PASSWORD=CHANGE_ME

# Runtime / tenant-scoped role (non-superuser, NOBYPASSRLS) used by the `pgsql_app` connection so
# Row-Level Security is actually enforced. Created + granted by the S1-05 migrations; the owner
# `DB_USERNAME` above still runs migrations and privileged auth lookups.
# PLACEHOLDER — the migration creates/keeps the `qayd_app` role at whatever value you set here, and
# the app connects with the same value, so they always match. Change it for anything but local dev.
DB_APP_USERNAME=qayd_app
DB_APP_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Pure-PHP client — works without the phpredis C extension. Set to `phpredis` on hosts that have it.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Identity / Auth (S1-07, S1-08) ---
# Password hashing: argon2id everywhere (AUTH_SERVICE.md). Do not weaken in production.
HASH_DRIVER=argon2id

# RS256 JWT for bearer clients. The PRIVATE key is a secret — generate the keypair with
# `php artisan qayd:jwt-keys`; it is written under storage/app/keys/jwt/ and MUST NOT be committed.
# Only these path pointers and the public key are ever shared. Leave the paths blank to use the
# config defaults (storage/app/keys/jwt/{private,public}.pem).
JWT_KID=qayd-default
JWT_ISSUER="${APP_URL}"
JWT_AUDIENCE=qayd-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Sanctum stateful SPA cookie: comma-separated first-party domains the web app runs on.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# --- Realtime (S2-13) ---------------------------------------------------------------------------
# Broadcasts are refresh NOTIFICATIONS only: they tell an open screen to re-read the API, and are never
# a write path or a source of truth (ADR-0006). `log` keeps local dev and CI working without a socket
# server — posting must not fail because a hint cannot be delivered. Production uses `reverb`.
# BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Serve with: php artisan reverb:start

# --- Field encryption (SPRINT_03 Phase 0) ------------------------------------------------------
# Two SEPARATE 32-byte keys, base64-encoded. The field key encrypts Restricted columns
# (XChaCha20-Poly1305); the index key derives the blind indexes that make equality lookup possible on
# a column whose ciphertext is randomly nonced. Keeping them apart is the point: leaking the index
# reveals no plaintext, and leaking the ciphertext reveals no index.
# FieldCipher REFUSES to run without these rather than inventing a key — one generated on the fly
# would encrypt today's rows into something no later process could ever read.
# Generate:  php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
FIELD_ENCRYPTION_KEY=
FIELD_INDEX_KEY=
# Retired field keys (comma-separated), kept only for the length of a rotation window.
FIELD_ENCRYPTION_RETIRED_KEYS=
