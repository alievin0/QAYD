# QAYD AI engine (FastAPI) — environment example. Copy to `.env` (git-ignored) for local dev.
# This sprint the engine exposes only a health route and reads NO environment variables; the entries
# below are documented placeholders for the shape of future config. Never commit real secrets.

# Bind address / port when the engine is run standalone (see apps/ai/README.md):
#   uv run uvicorn qayd_ai.main:app --reload --port 8001
AI_HOST=127.0.0.1
AI_PORT=8001

# The engine is reached only by apps/api (Laravel) over the private network — never exposed publicly.
# Model-provider credentials are injected as SECRETS from Sprint 03 onward; keep them out of the repo.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
