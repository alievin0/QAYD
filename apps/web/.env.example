# QAYD web (Next.js) — environment example. Copy to `.env.local` (git-ignored) for local dev.
# The browser never calls Laravel directly: BFF route handlers and server components proxy `/api/v1`
# holding the session bearer. The API base URL is the only config the web app needs this sprint.
#
# Resolution order in @qayd/shared `resolveApiBaseUrl()` (first non-empty wins):
#   NEXT_PUBLIC_API_BASE_URL  >  QAYD_API_BASE_URL  >  API_BASE_URL  >  http://localhost:8000/api/v1
# Never commit real secrets — only public, non-sensitive defaults belong here.

# Public base URL of the QAYD API, INCLUDING the `/api/v1` prefix. Baked into the client bundle at
# build time, so it must be set for non-local builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional server-only override (BFF / server components). Falls back to the public value above.
# QAYD_API_BASE_URL=http://localhost:8000/api/v1

# --- Realtime (S2-13) ---------------------------------------------------------------------------
# The public half of the Reverb connection, baked into the client bundle. Leave BLANK to disable
# realtime entirely: the subscriber then stays inert and every screen behaves exactly as it does today,
# because a socket only ever triggers a re-read of the API. The APP KEY is public by design; the SECRET
# belongs to the API and must never appear here. Subscriptions are signed by the BFF at
# /api/broadcasting/auth, so the bearer token stays server-side.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
